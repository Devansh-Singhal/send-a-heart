{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/f",
      "destination": "/api/for"
    },
    {
      "source": "/for",
      "destination": "/api/for"
    },
    {
      "source": "/made",
      "destination": "/"
    }
  ],
  "functions": {
    "api/for.js": {
      "includeFiles": "heart.html"
    }
  },
  "headers": [
    {
      "source": "/cards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/heart-audio.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
